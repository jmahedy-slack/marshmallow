# Slack (Socket Mode)
CLAIMS_FRAUD_SLACK_BOT_TOKEN=xoxb-your-bot-token
CLAIMS_FRAUD_SLACK_APP_TOKEN=xapp-your-app-token
CLAIMS_FRAUD_SLACK_SIGNING_SECRET=your-signing-secret

# HTTP server (default 3002)
CLAIMS_FRAUD_PORT=3002

# Public HTTPS base URL for Slack carousel hero images (local demo images).
# Required for carousel images to load in Slack — Slack servers must reach your machine.
# 1. Start the agent: npm start
# 2. In another terminal: npm run tunnel   (or: ngrok http 3002)
# 3. Copy the ngrok https URL (no trailing slash) into this variable
# 4. Restart the agent
CLAIMS_FRAUD_PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Vision — damage image analysis
# Local default: Ollama. Heroku (DYNO set): OpenAI unless overridden.
# CLAIMS_FRAUD_VISION_PROVIDER=openai
# CLAIMS_FRAUD_OLLAMA_ENABLED=false
# CLAIMS_FRAUD_VISION_API_KEY=sk-...
# CLAIMS_FRAUD_VISION_MODEL=gpt-4o-mini
# CLAIMS_FRAUD_VISION_BASE_URL=https://api.openai.com/v1

# Heroku: CLAIMS_FRAUD_PUBLIC_BASE_URL defaults to https://<app>.herokuapp.com
# Heroku Salesforce: SFDX_AUTH_URL from `sf org display --target-org YOUR_ORG --verbose --json`

# Jira Cloud — create incident follow-ups from Slack channels
# Generate API token: https://id.atlassian.com/manage-profile/security/api-tokens
# CLAIMS_FRAUD_JIRA_ENABLED=true
# CLAIMS_FRAUD_JIRA_BASE_URL=https://your-org.atlassian.net
# CLAIMS_FRAUD_JIRA_EMAIL=you@example.com
# CLAIMS_FRAUD_JIRA_API_TOKEN=your-atlassian-api-token
# CLAIMS_FRAUD_JIRA_PROJECT_KEY=EMAL
# CLAIMS_FRAUD_JIRA_ISSUE_TYPE=Task
# CLAIMS_FRAUD_JIRA_DEFAULT_LABELS=mobile-outage,sev1
# CLAIMS_FRAUD_INCIDENT_SLACK_CHANNEL=C0BBZ0ERKNU

# Confluence — incident runbooks (same Atlassian email/token as Jira)
# CLAIMS_FRAUD_CONFLUENCE_ENABLED=true
# CLAIMS_FRAUD_CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
# CLAIMS_FRAUD_CONFLUENCE_SPACE_KEY=SD
# CLAIMS_FRAUD_CONFLUENCE_PARENT_PAGE_ID=
